#include <physical_layouts.dtsi>

/ {
    demeter_physical_layout: demeter_physical_layout {
        compatible = "zmk,physical-layout";
        display-name = "Demeter";

        transform = <&default_transform>;

        /* keys[] is indexed by keymap position (same order as the transform map):
           rows 0-2 = left 5 + right 5, then 30 unused, 31-32 left thumbs,
           33-34 right thumbs, 35 unused. */
        keys  //                     w    h     x    y      rot    rx    ry
            = <&key_physical_attrs 100 100     0   88       30    50   138>  /*  0  Q */
            , <&key_physical_attrs 100 100   112   30        0     0     0>  /*  1  W */
            , <&key_physical_attrs 100 100   212    0        0     0     0>  /*  2  E */
            , <&key_physical_attrs 100 100   312   30        0     0     0>  /*  3  R */
            , <&key_physical_attrs 100 100   412   51        0     0     0>  /*  4  T */

            , <&key_physical_attrs 100 100   517   51        0     0     0>  /*  5  Y */
            , <&key_physical_attrs 100 100   617   30        0     0     0>  /*  6  U */
            , <&key_physical_attrs 100 100   717    0        0     0     0>  /*  7  I */
            , <&key_physical_attrs 100 100   817   30        0     0     0>  /*  8  O */
            , <&key_physical_attrs 100 100   929   88    35700   979   138>  /*  9  P */

            , <&key_physical_attrs 100 100     5  182       30    55   232>  /* 10  A */
            , <&key_physical_attrs 100 100   112  124        0     0     0>  /* 11  S */
            , <&key_physical_attrs 100 100   212   94        0     0     0>  /* 12  D */
            , <&key_physical_attrs 100 100   312  124        0     0     0>  /* 13  F */
            , <&key_physical_attrs 100 100   412  146        0     0     0>  /* 14  G */

            , <&key_physical_attrs 100 100   517  146        0     0     0>  /* 15  H */
            , <&key_physical_attrs 100 100   617  124        0     0     0>  /* 16  J */
            , <&key_physical_attrs 100 100   717   94        0     0     0>  /* 17  K */
            , <&key_physical_attrs 100 100   817  124        0     0     0>  /* 18  L */
            , <&key_physical_attrs 100 100   924  182    35700   974   232>  /* 19  ' */

            , <&key_physical_attrs 100 100    10  277       30    60   327>  /* 20  Z */
            , <&key_physical_attrs 100 100   112  219        0     0     0>  /* 21  X */
            , <&key_physical_attrs 100 100   212  189        0     0     0>  /* 22  C */
            , <&key_physical_attrs 100 100   312  219        0     0     0>  /* 23  V */
            , <&key_physical_attrs 100 100   412  240        0     0     0>  /* 24  B */

            , <&key_physical_attrs 100 100   517  240        0     0     0>  /* 25  N */
            , <&key_physical_attrs 100 100   617  219        0     0     0>  /* 26  M */
            , <&key_physical_attrs 100 100   717  189        0     0     0>  /* 27  , */
            , <&key_physical_attrs 100 100   817  219        0     0     0>  /* 28  . */
            , <&key_physical_attrs 100 100   919  277    35700   969   327>  /* 29  RET */

            , <&key_physical_attrs   0   0     0    0        0     0     0>  /* 30  --  unused outer thumb (no physical key) */
            , <&key_physical_attrs 100 100   432  383    34800   482   433>  /* 31  LTH1 */
            , <&key_physical_attrs 100 100   503  454    34800   553   504>  /* 32  LTH2 */
            , <&key_physical_attrs 100 100   497  383     1200   547   433>  /* 33  RTH1 */
            , <&key_physical_attrs 100 100   426  454     1200   476   504>  /* 34  RTH2 */
            , <&key_physical_attrs   0   0     0    0        0     0     0>  /* 35  --  unused outer thumb (no physical key) */
            ;
    };
};
